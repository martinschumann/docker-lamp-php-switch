##########################
# Choose a PHP version for
# the php-fpm container
##########################
# PHP_VERSION=8.2
# PHP_VERSION=8.3
# PHP_VERSION=8.4
# PHP_VERSION=8.5

#####################################
# Set the host UID and GID 
# for ubuntu in the PHP-FPM container
#####################################
# HOST_UID=
# HOST_GID=

#####################################
# Enable database services as needed
# by uncommenting either line or both
#####################################
# USE_MARIADB=1
# USE_POSTGRES=1
