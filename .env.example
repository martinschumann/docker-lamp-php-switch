##########################
# Choose a PHP version for
# the php-fpm container
##########################
# PHP_VERSION=8.2
# PHP_VERSION=8.3
PHP_VERSION=8.4
# PHP_VERSION=8.5

##################################
# Set the UID and GID for the 
# shell login into container "php"
##################################
HOST_UID=501
HOST_GID=20

PKI_DIR=/opt/pki
ROOT_CA_CONF_FILE=CA_lamp-php-switch.cnf
ROOT_CA_KEY_FILE=root-ca-lamp-php-switch.key
ROOT_CA_CERT_FILE=root-ca-lamp-php-switch.crt
CONF_FILE=wildcard.lamp.localhost.cnf
CSR_FILE=wildcard.lamp.localhost.csr
KEY_FILE=wildcard.lamp.localhost.key
CERT_FILE=wildcard.lamp.localhost.crt
APACHE_SSL_DIR=/etc/apache2/ssl
